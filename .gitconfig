[user]
  name = shimma
  email = shimma.dev@gmail.com
[color]
  status = auto
  diff = auto
  branch = auto
  interactive = auto
  grep = auto
	ui = true
[push]
  default = current
  ; default = tracking
[core]
	excludesfile = ~/.gitignore
  quotepath = false
  editor = /opt/homebrew/bin/nvim
	autocrlf = false
  precomposeunicode = true
	pager = delta
[alias]
  # 現在のブランチの GitHub compare ページを開く（旧 hub の git compare）
  compare = "!open \"$(gh repo view --json url -q .url)/compare/$(git branch --show-current)\""
  st = status
  co = checkout
  fetch-pulls = fetch origin +refs/pull/*:refs/remotes/pull/*
[ghq]
  root = ~/src
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[http]
	postBuffer = 524288000
[color "diff"]
	meta = 227
	frag = magenta bold
	commit = 227 bold
	old = red bold
	new = green bold
	whitespace = red reverse
[init]
	defaultBranch = main
[coderabbit]
	machineId = cli/da2232c4580446298a6ebdfcadd79582
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
